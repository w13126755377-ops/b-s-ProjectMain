# ===== 后端环境变量示例（复制为 .env 或由 docker-compose 注入） =====
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=approval_db

# JWT 密钥（生产环境务必修改）
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES=7d

# 附件存储目录（Docker 中固定 /app/uploads，挂载 volume）
UPLOAD_DIR=/app/uploads

# Web Push（可选增强，未配置时自动禁用；需 HTTPS 或 localhost 环境）
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
